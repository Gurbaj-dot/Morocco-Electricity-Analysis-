# --------------------------
# 1. Import Required Libraries
# --------------------------
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Set style for cleaner charts
sns.set_style("whitegrid")
plt.rcParams["figure.figsize"] = (12, 6)

# --------------------------
# 2. Load & Prepare Data
# --------------------------
# Load your CSV file
df = pd.read_csv("/content/sample_data/powerconsumption[1].csv")

# Convert datetime column to proper date/time format
df['Datetime'] = pd.to_datetime(df['Datetime'])

# Extract date parts for analysis
df['Date'] = df['Datetime'].dt.date
df['Hour'] = df['Datetime'].dt.hour
df['DayOfWeek'] = df['Datetime'].dt.day_name()
df['DayOfWeekNum'] = df['Datetime'].dt.dayofweek # 0=Monday, 6=Sunday

# Calculate total consumption across all 3 zones
df['TotalConsumption'] = df[['PowerConsumption_Zone1', 'PowerConsumption_Zone2', 'PowerConsumption_Zone3']].sum(axis=1)

# Check for missing values (clean data)
print("Missing values per column:")
print(df.isnull().sum())
print("\nData is ready for analysis!")

# --------------------------
# 3. Objective 2: Seasonal Trend Line Chart
# --------------------------
# Calculate average total consumption per day
daily_trend = df.groupby('Date')['TotalConsumption'].mean().reset_index()

# Plot the trend
plt.figure(figsize=(12, 5))
sns.lineplot(data=daily_trend, x='Date', y='TotalConsumption', marker='o', linewidth=2, color='#2dd4bf')
plt.title("Daily Average Electricity Consumption (Jan 1–4, 2017)", fontsize=14, pad=20)
plt.xlabel("Date", fontsize=12)
plt.ylabel("Total Consumption (kWh)", fontsize=12)
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()

# --------------------------
# 4. Objective 3: Hour vs Day Heatmap
# --------------------------
# Order days correctly for the heatmap
day_order = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']

# Create pivot table for heatmap
heatmap_data = df.pivot_table(
    index='Hour',
    columns='DayOfWeek',
    values='TotalConsumption',
    aggfunc='mean'
).reindex(columns=day_order)

# Plot heatmap
plt.figure(figsize=(12, 8))
sns.heatmap(heatmap_data, cmap='YlOrRd', annot=False, linewidths=0.5, cbar_kws={'label': 'Average Consumption (kWh)'})
plt.title("Electricity Consumption: Hour of Day vs Day of Week", fontsize=14, pad=20)
plt.xlabel("Day of Week", fontsize=12)
plt.ylabel("Hour of Day", fontsize=12)
plt.tight_layout()
plt.show()

# --------------------------
# 5. Bonus: Weather Correlation Analysis
# --------------------------
# Calculate correlation between consumption and weather factors
correlation = df[['TotalConsumption', 'Temperature', 'Humidity', 'WindSpeed']].corr()

# Plot correlation heatmap
plt.figure(figsize=(8, 5))
sns.heatmap(correlation, annot=True, cmap='coolwarm', fmt='.2f', vmin=-1, vmax=1)
plt.title("Correlation: Consumption vs Weather", fontsize=14, pad=20)
plt.tight_layout()
plt.show()

# --------------------------
# 6. Key Summary Findings
# --------------------------
print("\n=== KEY BUSINESS INSIGHTS ===")
# Peak hour
peak_hour = df.groupby('Hour')['TotalConsumption'].mean().idxmax()
peak_hour_val = df.groupby('Hour')['TotalConsumption'].mean().max()
print(f"✅ Highest consumption hour: {peak_hour}:00 (avg {round(peak_hour_val):,} kWh)")

# Peak day
peak_day = df.groupby('DayOfWeek')['TotalConsumption'].mean().idxmax()
peak_day_val = df.groupby('DayOfWeek')['TotalConsumption'].mean().max()
print(f"✅ Highest consumption day: {peak_day} (avg {round(peak_day_val):,} kWh)")

# Strongest weather link
weather_corr = correlation['TotalConsumption'].drop('TotalConsumption').abs().idxmax()
corr_strength = round(correlation['TotalConsumption'].drop('TotalConsumption').abs().max(), 2)
print(f"✅ Strongest weather factor: {weather_corr} (correlation = {corr_strength})")
